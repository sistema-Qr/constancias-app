<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Panel · Sistema de Constancias</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { empleado, activo }) %>

    <main class="main-content">
      <div class="row-between">
        <h2>Constancias emitidas</h2>
        <a href="/constancias/nueva" class="btn btn-primary">+ Nueva constancia</a>
      </div>

      <form method="GET" action="/dashboard" class="search-bar">
        <input type="text" name="q" value="<%= q || '' %>" placeholder="Buscar por nombre, matrícula, folio o programa..." />
        <button type="submit" class="btn btn-secondary">Buscar</button>
        <% if (q) { %>
          <a href="/dashboard" class="btn-link">Limpiar</a>
        <% } %>
      </form>

      <table class="table">
        <thead>
          <tr>
            <th>Folio</th>
            <th>Tipo</th>
            <th>Nombre</th>
            <th>Matrícula</th>
            <th>Programa</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Emitió</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% const etiquetasTipo = { termino: 'Término', avance: 'Avance', docente: 'Docente' }; %>
          <% constancias.forEach(c => { %>
            <tr>
              <td><%= c.folio %></td>
              <td><span class="badge badge-neutral"><%= etiquetasTipo[c.tipo] || c.tipo %></span></td>
              <td><%= c.nombre %> <%= c.apellido_paterno %> <%= c.apellido_materno %></td>
              <td><%= c.matricula || '—' %></td>
              <td><%= c.programa || '—' %></td>
              <td><%= c.fecha_emision instanceof Date ? c.fecha_emision.toISOString().slice(0,10) : c.fecha_emision %></td>
              <td>
                <span class="badge <%= c.estado === 'activa' ? 'badge-ok' : 'badge-off' %>">
                  <%= c.estado === 'activa' ? 'Activa' : 'Revocada' %>
                </span>
              </td>
              <td><%= c.emitido_por_nombre %></td>
              <td class="actions">
                <a href="/constancias/<%= c.token %>/pdf" target="_blank">PDF</a>
                <a href="/constancias/<%= c.token %>/editar">Editar</a>
                <% if (empleado.rol === 'admin') { %>
                  <a href="/verify/<%= c.token %>" target="_blank">Verificar</a>
                  <% if (c.estado === 'activa') { %>
                    <form method="POST" action="/constancias/<%= c.token %>/revocar" onsubmit="return confirm('¿Revocar esta constancia? Ya no se validará como auténtica.');" style="display:inline">
                      <button class="btn-link btn-danger" type="submit">Revocar</button>
                    </form>
                  <% } %>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (constancias.length === 0) { %>
            <tr><td colspan="9" class="empty"><%= q ? 'No se encontraron constancias con ese criterio de búsqueda.' : 'Aún no se han emitido constancias.' %></td></tr>
          <% } %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>
