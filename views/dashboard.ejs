<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Panel · Sistema de Constancias</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">CUEJ · Constancias</div>
    <div class="user-info">
      <span>Hola, <%= empleado.nombre_completo %></span>
      <form method="POST" action="/logout" style="display:inline">
        <button class="btn-link" type="submit">Cerrar sesión</button>
      </form>
    </div>
  </header>

  <main class="container">
    <div class="row-between">
      <h2>Constancias emitidas</h2>
      <a href="/constancias/nueva" class="btn btn-primary">+ Nueva constancia</a>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th>Folio</th>
          <th>Alumno</th>
          <th>Matrícula</th>
          <th>Programa</th>
          <th>Fecha</th>
          <th>Estado</th>
          <th>Emitió</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% constancias.forEach(c => { %>
          <tr>
            <td><%= c.folio %></td>
            <td><%= c.nombre %> <%= c.apellido_paterno %> <%= c.apellido_materno %></td>
            <td><%= c.matricula %></td>
            <td><%= c.programa %></td>
            <td><%= c.fecha_emision %></td>
            <td>
              <span class="badge <%= c.estado === 'activa' ? 'badge-ok' : 'badge-off' %>">
                <%= c.estado === 'activa' ? 'Activa' : 'Revocada' %>
              </span>
            </td>
            <td><%= c.emitido_por_nombre %></td>
            <td class="actions">
              <a href="/constancias/<%= c.token %>/pdf" target="_blank">PDF</a>
              <a href="/verify/<%= c.token %>" target="_blank">Verificar</a>
              <% if (c.estado === 'activa') { %>
                <form method="POST" action="/constancias/<%= c.token %>/revocar" onsubmit="return confirm('¿Revocar esta constancia? Ya no se validará como auténtica.');" style="display:inline">
                  <button class="btn-link btn-danger" type="submit">Revocar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (constancias.length === 0) { %>
          <tr><td colspan="8" class="empty">Aún no se han emitido constancias.</td></tr>
        <% } %>
      </tbody>
    </table>
  </main>
</body>
</html>
