<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Eliminar constancia · Sistema de Constancias</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { empleado, activo }) %>

    <main class="main-content">
      <h2>Eliminar constancia</h2>

      <div class="alert alert-error">
        <strong>Esta acción es permanente.</strong> A diferencia de "Revocar" (que solo marca la constancia como no válida pero la conserva), eliminar la borra por completo de la base de datos. No se puede deshacer.
      </div>

      <table class="verify-table" style="max-width:520px; margin-bottom:24px;">
        <tr><th>Folio</th><td><%= c.folio %></td></tr>
        <tr><th>Nombre</th><td><%= c.nombre %> <%= c.apellido_paterno %> <%= c.apellido_materno %></td></tr>
        <tr><th>Tipo</th><td><%= c.tipo %></td></tr>
        <tr><th>Estado actual</th><td><%= c.estado %></td></tr>
      </table>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/constancias/<%= c.token %>/eliminar" class="form-grid" style="max-width:420px;">
        <fieldset>
          <legend>Confirmación</legend>
          <label>Contraseña de confirmación de eliminación *</label>
          <input type="password" name="password" required autofocus autocomplete="off" />
        </fieldset>

        <button type="submit" class="btn btn-danger-solid">Eliminar permanentemente</button>
      </form>

      <p style="margin-top:16px;"><a href="/dashboard" class="btn-link">Cancelar y volver al panel</a></p>
    </main>
  </div>
</body>
</html>
