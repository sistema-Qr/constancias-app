<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Acceso · Sistema de Constancias</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="center-page">
  <div class="card login-card">
    <img src="/img/logo_cuej_web.png" alt="CUEJ" class="login-logo" />
    <p class="subtitle">Sistema de Constancias Académicas</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <label>Usuario</label>
      <input type="text" name="username" required autofocus />

      <label>Contraseña</label>
      <input type="password" name="password" required />

      <button type="submit" class="btn btn-primary">Entrar</button>
    </form>
    <p class="hint">Acceso exclusivo para personal autorizado.</p>
  </div>
</body>
</html>
