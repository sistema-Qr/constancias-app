<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= editando ? 'Editar constancia' : 'Nueva constancia' %> · Sistema de Constancias</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar', { empleado, activo }) %>

    <main class="main-content">
      <h2><%= editando ? 'Editar constancia · Folio ' + valores.folio : 'Nueva constancia' %></h2>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST"
            action="<%= editando ? '/constancias/' + token + '/editar' : '/constancias/nueva' %>"
            enctype="multipart/form-data"
            class="form-grid">

        <fieldset>
          <legend>Tipo de constancia</legend>
          <% const tipoActual = valores.tipo || 'termino'; %>
          <% if (editando) { %>
            <input type="hidden" name="tipo" value="<%= tipoActual %>" />
            <p><strong><%= { termino: 'Constancia de término', avance: 'Constancia de avance', docente: 'Constancia de docente', servicio_social: 'Constancia de servicio social' }[tipoActual] %></strong> (el tipo no se puede cambiar después de creada la constancia)</p>
          <% } else { %>
            <div class="tipo-selector">
              <label class="tipo-opcion">
                <input type="radio" name="tipo" value="termino" onchange="actualizarCamposPorTipo()" <%= tipoActual === 'termino' ? 'checked' : '' %> />
                Constancia de término
              </label>
              <label class="tipo-opcion">
                <input type="radio" name="tipo" value="avance" onchange="actualizarCamposPorTipo()" <%= tipoActual === 'avance' ? 'checked' : '' %> />
                Constancia de avance
              </label>
              <label class="tipo-opcion">
                <input type="radio" name="tipo" value="docente" onchange="actualizarCamposPorTipo()" <%= tipoActual === 'docente' ? 'checked' : '' %> />
                Constancia de docente
              </label>
              <label class="tipo-opcion">
                <input type="radio" name="tipo" value="servicio_social" onchange="actualizarCamposPorTipo()" <%= tipoActual === 'servicio_social' ? 'checked' : '' %> />
                Constancia de servicio social
              </label>
            </div>
          <% } %>
        </fieldset>

        <fieldset>
          <legend>Datos personales</legend>

          <label>Nombre(s) *</label>
          <input type="text" name="nombre" value="<%= valores.nombre || '' %>" required />

          <label>Apellido paterno *</label>
          <input type="text" name="apellido_paterno" value="<%= valores.apellido_paterno || '' %>" required />

          <label>Apellido materno</label>
          <input type="text" name="apellido_materno" value="<%= valores.apellido_materno || '' %>" />
        </fieldset>

        <!-- ===================== CAMPOS: TÉRMINO / AVANCE ===================== -->
        <div id="campos-alumno">
          <fieldset>
            <legend>Datos del alumno</legend>

            <label>Matrícula *</label>
            <input type="text" name="matricula" value="<%= valores.matricula || '' %>" />

            <%
              const licenciaturas = [
                'Licenciatura en Derecho',
                'Licenciatura en Vista Aduanal y Comercio Exterior',
                'Licenciatura en Contaduría',
                'Licenciatura en Derecho (No escolarizada / En línea)'
              ];
              const maestrias = [
                'Maestría en Derecho Sanitario y Médico',
                'Maestría en Derecho Aduanero y Derecho de Comercio Exterior',
                'Maestría en Derecho Civil y Familiar',
                'Maestría en Derecho Constitucional',
                'Maestría en Derecho Fiscal y Administrativo',
                'Maestría en Sistema Acusatorio y Juicios Penales Orales',
                'Maestría en Derecho Marítimo y Derecho Portuario',
                'Maestría en Filosofía e Historia',
                'Maestría en Derecho Aduanero y Derecho de Comercio Exterior (No escolarizado)'
              ];
              const doctorados = [
                'Doctorado en Derecho',
                'Doctorado en Derecho Aduanero y Derecho de Comercio Exterior',
                'Doctorado en Derecho Fiscal',
                'Doctorado en Derechos Humanos y Derecho Constitucional',
                'Doctorado en Derecho Aduanero y Derecho de Comercio Exterior (No escolarizado)'
              ];
              const todosLosProgramas = [...licenciaturas, ...maestrias, ...doctorados];
              const programaActual = valores.programa || '';
              const programaEnLista = todosLosProgramas.includes(programaActual);
            %>

            <label id="label-programa">Licenciatura / Posgrado *</label>
            <select name="programa" id="programa_select" onchange="onProgramaChange()">
              <option value="" <%= !programaActual ? 'selected' : '' %>>-- Selecciona --</option>
              <optgroup label="Licenciaturas">
                <% licenciaturas.forEach(p => { %>
                  <option <%= programaActual === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </optgroup>
              <optgroup label="Maestrías" id="optgroup-maestrias">
                <% maestrias.forEach(p => { %>
                  <option <%= programaActual === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </optgroup>
              <optgroup label="Doctorados" id="optgroup-doctorados">
                <% doctorados.forEach(p => { %>
                  <option <%= programaActual === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </optgroup>
              <option value="__otro__" <%= (programaActual && !programaEnLista) ? 'selected' : '' %>>Otro (especificar)</option>
            </select>
            <input type="text" id="programa_otro" placeholder="Escribe el nombre del programa"
                   value="<%= (!programaEnLista) ? programaActual : '' %>"
                   style="display:<%= (programaActual && !programaEnLista) ? 'block' : 'none' %>; margin-top:6px;" />

            <label>Plan de estudios</label>
            <input type="text" name="plan_estudios" value="<%= valores.plan_estudios || '' %>" placeholder="Plan 2021" />

            <label>Promedio</label>
            <input type="text" name="promedio" value="<%= valores.promedio || '' %>" placeholder="9.5" />

            <label>Créditos obtenidos</label>
            <input type="text" name="creditos_obtenidos" value="<%= valores.creditos_obtenidos || '' %>" placeholder="180" />

            <label>Créditos totales</label>
            <input type="text" name="creditos_totales" value="<%= valores.creditos_totales || '' %>" placeholder="308" />

            <label>Ciclo de inicio</label>
            <input type="text" name="ciclo_inicio" value="<%= valores.ciclo_inicio || '' %>" placeholder="2023-1" />

            <label>Ciclo actual / de término</label>
            <input type="text" name="ciclo_fin" value="<%= valores.ciclo_fin || '' %>" placeholder="2026-1" />
          </fieldset>

          <fieldset>
            <legend>Destinatario (opcional)</legend>

            <label>Nombre del destinatario</label>
            <input type="text" name="destinatario_nombre" value="<%= valores.destinatario_nombre || '' %>" placeholder="Ing. Roció Corazón García Salas" />

            <label>Cargo del destinatario</label>
            <textarea name="destinatario_cargo" rows="2"><%= valores.destinatario_cargo || '' %></textarea>
          </fieldset>

          <fieldset>
            <legend>Historial académico</legend>
            <label>Adjuntar historial académico (PDF, opcional)</label>
            <input type="file" name="historial" accept="application/pdf" />
            <% if (editando && valores.historial_pdf_nombre) { %>
              <p class="hint">Ya tiene un archivo adjunto: <strong><%= valores.historial_pdf_nombre %></strong>. Sube uno nuevo solo si quieres reemplazarlo.</p>
            <% } else { %>
              <p class="hint">Se anexará como páginas adicionales al final del PDF de la constancia.</p>
            <% } %>
          </fieldset>

          <fieldset>
            <legend>Otros</legend>
            <label>Texto adicional (opcional)</label>
            <textarea name="texto_adicional" rows="3" placeholder="Ej. El alumno se encuentra en trámite de..."><%= valores.texto_adicional || '' %></textarea>
          </fieldset>
        </div>

        <!-- ===================== CAMPOS: DOCENTE ===================== -->
        <div id="campos-docente">
          <fieldset>
            <legend>Datos del docente</legend>

            <label>Título académico</label>
            <input type="text" name="titulo_docente" value="<%= valores.titulo_docente || '' %>" placeholder="Doctora / Maestro / Licenciada..." />

            <label>Cargo</label>
            <input type="text" name="cargo_docente" value="<%= valores.cargo_docente || '' %>" placeholder="catedrática / catedrático" />

            <label>Plan de estudios donde imparte clase</label>
            <input type="text" name="plan_estudios" value="<%= valores.plan_estudios || '' %>" placeholder="Licenciatura en Derecho" />

            <label>Materias donde es titular</label>
            <textarea name="materias_titular" rows="2" placeholder="Teoría general del Derecho penal, Estudio de los delitos, ..."><%= valores.materias_titular || '' %></textarea>

            <label>Otras materias que ha impartido</label>
            <textarea name="materias_impartidas" rows="2" placeholder="Filosofía y ética, Técnicas de investigación jurídica, ..."><%= valores.materias_impartidas || '' %></textarea>

            <label>Imparte clases desde</label>
            <input type="text" name="fecha_desde" value="<%= valores.fecha_desde || '' %>" placeholder="enero de 2018" />
          </fieldset>

          <fieldset>
            <legend>Desempeño y logros</legend>

            <label>Texto sobre su desempeño</label>
            <textarea name="texto_destacado" rows="3" placeholder="Demostrando puntualidad, responsabilidad y eficiencia en sus labores como docente..."><%= valores.texto_destacado || '' %></textarea>

            <label>Logros adicionales (cursos, conferencias, publicaciones...)</label>
            <textarea name="logros_adicionales" rows="3" placeholder="Cabe destacar que ha impartido diversos cursos y conferencias..."><%= valores.logros_adicionales || '' %></textarea>
          </fieldset>
        </div>

        <fieldset>
          <legend>Emisión</legend>
          <label>Lugar de emisión</label>
          <input type="text" name="lugar_emision" value="<%= valores.lugar_emision || 'Ciudad de México' %>" />

          <label>Fecha de emisión</label>
          <input type="date" name="fecha_emision" value="<%= valores.fecha_emision_input || '' %>" />
        </fieldset>

        <button type="submit" class="btn btn-primary"><%= editando ? 'Guardar cambios' : 'Generar constancia' %></button>
      </form>
    </main>
  </div>

  <script>
    function actualizarCamposPorTipo() {
      var tipo = 'termino';
      var oculto = document.querySelector('input[name="tipo"][type="hidden"]');
      if (oculto) {
        tipo = oculto.value;
      } else {
        var radios = document.querySelectorAll('input[name="tipo"]');
        radios.forEach(function (r) { if (r.checked) tipo = r.value; });
      }
      var esAlumno = (tipo === 'termino' || tipo === 'avance' || tipo === 'servicio_social');
      document.getElementById('campos-alumno').style.display = esAlumno ? 'block' : 'none';
      document.getElementById('campos-docente').style.display = esAlumno ? 'none' : 'block';
      document.querySelector('input[name="matricula"]').required = esAlumno;
      document.querySelector('[name="programa"]').required = esAlumno;
      // Servicio social: solo licenciaturas (las maestrías/doctorados no aplican)
      var soloLicenciatura = (tipo === 'servicio_social');
      var ogMaestrias = document.getElementById('optgroup-maestrias');
      var ogDoctorados = document.getElementById('optgroup-doctorados');
      var labelPrograma = document.getElementById('label-programa');
      var selPrograma = document.getElementById('programa_select');

      if (ogMaestrias) ogMaestrias.style.display = soloLicenciatura ? 'none' : '';
      if (ogDoctorados) ogDoctorados.style.display = soloLicenciatura ? 'none' : '';
      if (labelPrograma) labelPrograma.textContent = soloLicenciatura ? 'Licenciatura *' : 'Licenciatura / Posgrado *';

      if (soloLicenciatura && selPrograma) {
        var opcionActual = selPrograma.options[selPrograma.selectedIndex];
        var grupoActual = opcionActual ? opcionActual.parentElement.id : '';
        if (grupoActual === 'optgroup-maestrias' || grupoActual === 'optgroup-doctorados') {
          selPrograma.value = '';
        }
      }
    }
    actualizarCamposPorTipo();

    function onProgramaChange() {
      var sel = document.getElementById('programa_select');
      var otro = document.getElementById('programa_otro');
      if (sel.value === '__otro__') {
        otro.style.display = 'block';
        otro.focus();
      } else {
        otro.style.display = 'none';
      }
    }

    // Justo antes de enviar el formulario: si eligieron "Otro", el texto que
    // escribieron se convierte en el valor real que se manda como "programa".
    document.querySelector('form').addEventListener('submit', function () {
      var sel = document.getElementById('programa_select');
      var otro = document.getElementById('programa_otro');
      if (sel && sel.value === '__otro__' && otro && otro.value.trim()) {
        var opt = document.createElement('option');
        opt.value = otro.value.trim();
        opt.selected = true;
        sel.appendChild(opt);
      }
    });
  </script>
</body>
</html>
